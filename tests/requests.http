@baseUrl = http://localhost:3000

### 0a. Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "juandelacruz",
  "password": "juan123"
}

### 0b. Login — grab a token to use in the requests below
# After running this, copy the "token" value from the response
# and paste it into @token below.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "juandelacruz",
  "password": "juan123"
}

### Set this manually after running request 0b
@token = PASTE_TOKEN_HERE

### 1. GET all students
GET {{baseUrl}}/students
Authorization: Bearer {{token}}

### 2. POST a new student
# @name createStudent
POST {{baseUrl}}/students
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Test Student",
  "age": 20,
  "course": "Computer Science"
}

### 3. PATCH (update) the student just created
# Uses the id returned from request 2
PATCH {{baseUrl}}/students/{{createStudent.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "age": 21
}

### 4. GET all students again — confirm the update stuck
GET {{baseUrl}}/students
Authorization: Bearer {{token}}

### 5. DELETE the student created in request 2
DELETE {{baseUrl}}/students/{{createStudent.response.body.id}}
Authorization: Bearer {{token}}

### 6. GET all students again — to confirm it's gone
GET {{baseUrl}}/students
Authorization: Bearer {{token}}

### 7. PATCH a student that doesn't exist — should return 404
PATCH {{baseUrl}}/students/999
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "age": 30
}

### 8. DELETE a student that doesn't exist — should return 404
DELETE {{baseUrl}}/students/999
Authorization: Bearer {{token}}
